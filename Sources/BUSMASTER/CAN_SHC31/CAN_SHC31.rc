#include "ChannelSelectionResource.h"
#include "Shc31Resource.h"
#include "../DIL_Interface/ChannelSelection.rc"

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_SHC31_CHANNEL_SETTINGS DIALOGEX 0, 0, 250, 232
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CAN Channel Settings (DSD SH-C31x)"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Adapter:",IDC_STATIC,7,7,34,8
    LTEXT           "",IDC_SHC31_STATIC_DEVICE,44,7,199,8
    GROUPBOX        "CAN FD and bit timing",IDC_STATIC,7,20,236,128
    CONTROL         "Enable CAN FD",IDC_SHC31_CHK_FD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,32,90,10
    LTEXT           "Nominal bitrate (bit/s):",IDC_STATIC,16,50,80,8
    EDITTEXT        IDC_SHC31_EDIT_NOM_BITRATE,102,48,58,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Nominal sample point (%):",IDC_STATIC,16,66,88,8
    EDITTEXT        IDC_SHC31_EDIT_NOM_SP,102,64,58,12,ES_AUTOHSCROLL
    LTEXT           "Data bitrate (bit/s):",IDC_STATIC,16,86,80,8
    EDITTEXT        IDC_SHC31_EDIT_DATA_BITRATE,102,84,58,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Data sample point (%):",IDC_STATIC,16,102,88,8
    EDITTEXT        IDC_SHC31_EDIT_DATA_SP,102,100,58,12,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Listen only",IDC_SHC31_CHK_LISTEN_ONLY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,120,80,10
    LTEXT           "Achieved nominal:",IDC_STATIC,170,50,66,8
    LTEXT           "",IDC_SHC31_STATIC_NOM_ACHIEVED,170,60,66,18
    LTEXT           "Achieved data:",IDC_STATIC,170,86,66,8
    LTEXT           "",IDC_SHC31_STATIC_DATA_ACHIEVED,170,96,66,18
    LTEXT           "",IDC_SHC31_STATIC_WARNING,7,152,236,22
    GROUPBOX        "Identify",IDC_STATIC,7,178,236,26
    CONTROL         "Identify (blink LEDs)",IDC_SHC31_CHK_IDENTIFY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,186,90,10
    LTEXT           "",IDC_SHC31_STATIC_IDENTIFY,112,186,126,8
    DEFPUSHBUTTON   "OK",IDOK,136,210,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,192,210,50,14
END

#ifndef APSTUDIO_INVOKED
#endif    // not APSTUDIO_INVOKED
